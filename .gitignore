# The share-card renderer (@resvg/resvg-js) installs here in CI. Never commit it:
# native binaries, thousands of files. The workflow's git add is an explicit allowlist,
# so this is belt-and-braces against a future `git add -A`.
node_modules/
package-lock.json

# The test suite's sandbox country (code "zz"). Tests write real files under it; they
# must never be committed — the workflow's '*/films/' glob once published them.
zz/

# Cloudflare deploy staging folder (built from git archive in CI). Never committed.
_site/
.wrangler/

# Per-run build report read by scripts/health.js. Never committed.
run-health.json
# Per-run unit-test results (scripts/test.js), also read by health.js. Never committed.
test-results.json

# Built pages live on the `site` branch, not on main (scripts/site.js). The build restores
# them before it runs and publishes them after; never commit them here. Locally, run
# `node scripts/site.js restore` to get them.
/ae/
/au/
/br/
/ca/
/de/
/es/
/fr/
/id/
/jp/
/kr/
